# Copy/export only values you need. This file is documentation; it is NOT
# loaded automatically. Never commit real keys. Electron inherits its shell env.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Only enables the option; screenshots still require an explicit per-review opt-in.
LLM_VISION_ENABLED=false
# Comma-separated HTTPS feeds you have permission to collect and retain.
CORNWATCH_FEED_URLS=
CORNWATCH_POLL_INTERVAL=5m
# v0.6 defaults to seven public collectors; quote target interval is 500ms. Use false to pause all nine source
# automatic jobs; manual sync remains available. This does not affect RSS.
CORNWATCH_AUTO_SYNC=true
# Initial weather preference only; saved source settings take precedence.
# Free Open-Meteo service is for non-commercial use. Commercial use needs rights.
CORNWATCH_WEATHER_ENABLED=true
# Standalone/cloud backend: required >=32 chars for a non-loopback listener.
# Electron generates a new session token automatically.
CORNWATCH_TOKEN=
CORNWATCH_ALLOWED_ORIGIN=

# Optional separate adapters/tqsdk_bridge.py process. Not needed for public data.
# Tq account rights apply. The bridge token is your own 32+ character secret.
TQ_USER=
TQ_PASSWORD=
CORNWATCH_BRIDGE_TOKEN=

# Daily-report scheduler only. Saved UI settings choose model and times.
# Reports inherit LLM_* initially; saved report-specific settings override them.
# Runs on weekdays 08:30/15:30 Asia/Shanghai by default, if configured.
# false pauses automatic reports, leaving manual report generation available.
CORNWATCH_REPORT_AUTO=true

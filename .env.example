# Copy/export only values you need. This file is documentation; it is NOT
# loaded automatically. Never commit real keys. Electron inherits its shell env.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Only enables the option; screenshots still require an explicit per-review opt-in.
LLM_VISION_ENABLED=false
# Comma-separated HTTPS feeds you have permission to collect and retain.
CORNWATCH_FEED_URLS=
CORNWATCH_POLL_INTERVAL=5m
# Set true to collect weather at startup and then at most hourly.
# Free Open-Meteo endpoint is for non-commercial evaluation/prototyping.
CORNWATCH_WEATHER_ENABLED=false
# Standalone/cloud backend: required >=32 chars for a non-loopback listener.
# Electron generates a new session token automatically.
CORNWATCH_TOKEN=
CORNWATCH_ALLOWED_ORIGIN=
